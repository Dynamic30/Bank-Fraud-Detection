# Copy to .env locally. On Render, set these as environment variables on the web service.

# app (required). Render: use the Postgres "Internal Database URL"
APP_DATABASE_URL=postgresql://peecha:change-me@db:5432/peecha_app
# Render looks for the app on this port; the Dockerfile listens on 8000
PORT=8000

# live answers in /api/ask (optional), through the Adaption API. LLM_MODEL is a hosted model id such as qwen3.5-397b
LLM_PROVIDER_URL=https://api.prod.adaptionlabs.ai
LLM_API_KEY=
LLM_MODEL=

# prevention calls (optional). ELEVENLABS_TEST_NUMBER sends every call to that number instead of the account holder
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_TEST_NUMBER=

# local docker compose only
POSTGRES_USER=peecha
POSTGRES_PASSWORD=change-me
POSTGRES_DB=peecha_app
BANK_DB=dummy_sources

# bank + crypto source database, read by the orchestrator (from the app container / from the host for the seeder)
BANK_DATABASE_URL=postgresql://peecha:change-me@host.docker.internal:5433/dummy_sources
BANK_DATABASE_URL_HOST=postgresql://peecha:change-me@localhost:5433/dummy_sources
