# Copy to .env for local use. On Render, set these as environment variables on the web service instead.

# --- app (needed) ---
# App database. Local docker compose: the `db` service below. Render: the Postgres "Internal Database URL"
# (use the External URL with ?sslmode=require only when connecting from outside Render).
APP_DATABASE_URL=postgresql://peecha:change-me@db:5432/peecha_app
# Render looks for the app on this port; the Dockerfile listens on 8000.
PORT=8000

# --- optional ---
# Enables live answers in /api/ask (a canned answer is returned without it).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Prevention calls (used by the orchestrator, not by the web app).
eleven_labs=

# --- local docker compose only (db and bank-db containers) ---
POSTGRES_USER=peecha
POSTGRES_PASSWORD=change-me
POSTGRES_DB=peecha_app
BANK_DB=dummy_sources

# --- pipeline only (seeder, bank connectors, orchestrator; the web app does not read these) ---
# Bank + crypto source database (dummy_sources). From inside the app container:
BANK_DATABASE_URL=postgresql://peecha:change-me@host.docker.internal:5433/dummy_sources
# From the host (seeder, scripts):
BANK_DATABASE_URL_HOST=postgresql://peecha:change-me@localhost:5433/dummy_sources
